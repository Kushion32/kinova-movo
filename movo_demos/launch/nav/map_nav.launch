<!-- 2D Map navigation Demo -->

<launch>
    <arg name="map_file" default="test_zone"/>
    <arg name="use_waypoints" default="false"/>
    <arg name="sim" default="false"/>
    <arg name="local" default="true"/>
    <arg name="rosconsole_config" default="$(find movo_people)/config/person_following_rosconsole.config"/>

    <machine name="movo1" address="movo1" user="robohub"
                 env-loader="/home/robohub/env.sh" default="true" unless="$(arg local)"/>

    <!-- Run the map server -->
    <node name="map_server" pkg="map_server" type="map_server" args="$(find movo_demos)/maps/$(arg map_file).yaml" output="log" />

    <!-- NOTE: movo_move_base is intentionally NOT started here.
         It is already running from the robot bringup. Starting a second
         instance kills the bringup one mid-navigation (state 9 LOST). -->

    <!--- Run amcl -->
        <node pkg="amcl" type="amcl" name="amcl" output="log" clear_params="true">
            <env name="ROSCONSOLE_CONFIG_FILE" value="$(arg rosconsole_config)"/>
            <rosparam command="load" file="$(find movo_demos)/config/2d_nav/amcl.yaml"/>
            <remap from="scan" to="/movo/base_scan_filtered" />
    </node>

    <!--- Run Move Base -->
    <include file="$(find movo_demos)/launch/nav/move_base.launch">
        <arg name="no_static_map" value="false"/>
        <arg name="local" value="$(arg local)"/>
        <arg name="rosconsole_config" value="$(arg rosconsole_config)"/>
    </include>

</launch>
